# Application
APP_BASE_URL=http://localhost:3000
AA_PROVIDER=mock
AA_REDIRECT_URI=http://localhost:3000/aa-test
AA_TRANSACTION_LOOKBACK_MONTHS=6

# Supabase / PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Setu Account Aggregator, required only when AA_PROVIDER=setu
SETU_ENVIRONMENT=sandbox
SETU_FIU_BASE_URL=https://fiu-sandbox.setu.co
SETU_AUTH_BASE_URL=https://orgservice-prod.setu.co/v1
SETU_CLIENT_ID=replace-with-setu-client-id
SETU_CLIENT_SECRET=replace-with-setu-client-secret
SETU_PRODUCT_INSTANCE_ID=replace-with-setu-product-instance-id
